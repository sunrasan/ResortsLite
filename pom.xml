<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>


    <!--
        Issue fix: Spring Boot 2.7.18 Incompatible with Java 17
        Updated Spring Boot parent from 2.7.15 to 3.3.4 for full Java 17 / Jakarta EE compatibility.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>resortsLite</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>ResortsLite</name>
    <description>Resort booking demo — Java 17 / Spring Boot 3.3.x</description>

    <properties>
        <!--
            Issue fix: Java Version Property Still Set to 1.8 in pom.xml
            Updated java.version, maven.compiler.source, and maven.compiler.target from 1.8 to 17.
        -->
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- Explicit dependency versions for Java 17 compatibility -->
        <mysql.connector.version>8.2.0</mysql.connector.version>
        <thymeleaf-extras-java8time.version>3.0.4.RELEASE</thymeleaf-extras-java8time.version>
        <postgresql.version>42.7.3</postgresql.version>
        <log4j2.version>2.23.1</log4j2.version>
        <commons-collections.version>3.2.2</commons-collections.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Web Starter (includes Jakarta Servlet API via Spring Boot 3.x) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot JDBC Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Spring Boot Validation Starter (Jakarta Validation / Hibernate Validator) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Issue fix: log4j-core 2.14.1 Has Critical CVE-2021-44228 (Log4Shell RCE)
            Updated log4j-core from 2.14.1 to 2.23.1 to remediate CVE-2021-44228.
        -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j2.version}</version>
        </dependency>

        <!--
            Issue fix: commons-collections 3.2.1 Has Critical CVE-2015-6420 (RCE via Deserialization)
            Updated commons-collections from 3.2.1 to 3.2.2 to remediate CVE-2015-6420.
        -->
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>${commons-collections.version}</version>
        </dependency>

        <!--
            Issue fix: mysql-connector-java needs update for better Java 17 support
            Updated mysql-connector-java to 8.2.0 for Java 17 compatibility.
            Note: Retained for legacy compatibility; PostgreSQL driver added as primary DB driver.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.connector.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            Issue fix: Add PostgreSQL JDBC driver for PostgreSQL 16 compatibility.
            Replaces SQL Server / MySQL as the primary database provider.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- H2 in-memory database for development/testing -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Issue fix: thymeleaf-extras-java8time needs update for newer Spring Boot versions
            Updated thymeleaf-extras-java8time to 3.0.4.RELEASE for compatibility.
            Note: In Spring Boot 3.x, Thymeleaf 3.1+ includes java8time support natively.
        -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-java8time</artifactId>
            <version>${thymeleaf-extras-java8time.version}</version>
        </dependency>

        <!-- Spring Boot Test Starter (JUnit 5 / Jupiter included via Spring Boot 3.x) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Issue fix: Maven Compiler Plugin Not Explicitly Configured for Java 17
                Updated maven-compiler-plugin from 3.7.0 to 3.13.0 and set source/target/release to 17.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <release>17</release>
                    <annotationProcessorPaths>
                        <!-- Lombok annotation processor path for Java 17 compatibility -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.34</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Spring Boot Maven Plugin for packaging -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Surefire plugin configured for JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
